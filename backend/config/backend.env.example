INFRA_AV_PROJECT_ROOT=/path/to/INFRA-AV
INFRA_AV_HOST=127.0.0.1
INFRA_AV_PORT=5000
INFRA_AV_JWT_SECRET=replace-with-a-long-random-secret
INFRA_AV_DATA_DIR=/var/lib/infra-av
INFRA_AV_PAM_SERVICE=infra-av
INFRA_AV_DEFAULT_ROLE=admin
INFRA_AV_USERS_FILE=/etc/infra-av/users.json
INFRA_AV_CLAMSCAN_BIN=/usr/bin/clamscan
INFRA_AV_FRESHCLAM_BIN=/usr/bin/freshclam
INFRA_AV_ALLOWED_SCAN_ROOTS=/home,/srv,/tmp
INFRA_AV_ALLOWED_WRITE_ROOTS=/var/lib/infra-av/quarantine
INFRA_AV_ALLOWED_DATABASE_ROOTS=/var/lib/clamav,/usr/local/share/clamav
INFRA_AV_ALLOW_DEVICE_SCANS=0
INFRA_AV_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://localhost:8099,https://127.0.0.1:8099
