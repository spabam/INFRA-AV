{
  "openapi": "3.1.0",
  "info": {
    "title": "UUUUI Antivirus API",
    "version": "1",
    "description": "VANTAGE Antivirus (ClamAV) backend. The UUUUI API contract v1 surface (/api/health, /api/capabilities, /api/openapi.json) is served natively in the standard {ok,data} envelope. The scan surface is the legacy {action,payload} dispatch at POST /api, normalized by the shared client; its full REST conversion is the remaining Tier-A step.",
    "x-uuuui-module": "av",
    "x-uuuui-grant": "av"
  },
  "servers": [
    {
      "url": "/api/av"
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthenticated",
                  "forbidden",
                  "not_found",
                  "invalid",
                  "conflict",
                  "quota",
                  "unavailable",
                  "internal"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "Health",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string"
                        },
                        "version": {
                          "type": "string"
                        },
                        "contract": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/capabilities": {
      "get": {
        "summary": "Declared capabilities",
        "responses": {
          "200": {
            "description": "Capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This schema",
        "responses": {
          "200": {
            "description": "OpenAPI document"
          }
        }
      }
    },
    "/": {
      "post": {
        "summary": "Scan action dispatch (legacy {action,payload})",
        "description": "Actions: auth.login, auth.sso, health.check, scan.submit, scan.browse, scan.status, scan.report, scan.list, scan.pause, scan.resume, scan.stop, scan.runWorkerOnce, signatures.update.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Action result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {}
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
