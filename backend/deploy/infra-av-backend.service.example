[Unit]
Description=INFRA-AV Rust backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/INFRA-AV/backend
EnvironmentFile=/etc/infra-av/backend.env
ExecStart=/path/to/INFRA-AV/backend/target/release/infra-av-backend server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
